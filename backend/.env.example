# Copy this file to `.env` and fill in your key.
#   cp .env.example .env

# Your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Preferred model. If it isn't available to your key, the backend automatically
# picks a working one it discovers from the API. "latest" aliases are safest.
GEMINI_MODEL=gemini-flash-latest

# Port the backend listens on.
PORT=8787

# Comma-separated list of allowed origins for CORS.
# Browser extensions send an origin like chrome-extension://<id> or
# moz-extension://<id>. Leave as * for local development.
ALLOWED_ORIGINS=*
