# OPTIONAL. You normally DON'T need to edit this file — pick your provider,
# paste your API key, and choose a model right inside the extension (click the
# 🔑 button). The backend runs fine with no keys here.
#
# These values are only used as a FALLBACK when the extension doesn't send a
# provider/key (e.g. if you deploy the backend and want a server-side default).

# Fallback provider: gemini | openai | anthropic | openrouter | groq | mistral | ollama
PROVIDER=gemini

# Optional: force a specific model. If empty, a sensible default (or an
# auto-discovered one for Gemini) is used. You can also switch models from the
# extension header at runtime.
MODEL=

# ── Provider API keys (set the one matching PROVIDER above) ──────────────────
# Gemini    → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI    → https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic → https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenRouter (one key, many models) → https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Groq      → https://console.groq.com/keys
GROQ_API_KEY=
# Mistral   → https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Ollama (local, no key needed) — just run `ollama serve`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8787
# CORS origins (comma-separated). Leave * for local development.
ALLOWED_ORIGINS=*
