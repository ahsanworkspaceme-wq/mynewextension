# Copy this file to `.env` and fill in your key.
#   cp .env.example .env

# Your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use. Good options: gemini-2.5-flash (fast, cheap), gemini-2.5-pro (smarter).
GEMINI_MODEL=gemini-2.5-flash

# Port the backend listens on.
PORT=8787

# Comma-separated list of allowed origins for CORS.
# Browser extensions send an origin like chrome-extension://<id> or
# moz-extension://<id>. Leave as * for local development.
ALLOWED_ORIGINS=*
